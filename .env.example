# Public Matrix server identity used by the bridge for room aliases and user IDs.
MATRIX_DOMAIN=matrix.example.com

# Public base URL the bridge uses to reach your homeserver.
MATRIX_HOMESERVER_URL=https://matrix.example.com

# Host port published by Docker Compose.
BRIDGE_PORT=9005

# Bind address inside the container. Keep 0.0.0.0 unless you know you need something else.
BRIDGE_BIND_ADDRESS=0.0.0.0

# Discord bot token from the Discord developer portal.
DISCORD_BOT_TOKEN=replace-me

# Discord application client ID.
DISCORD_CLIENT_ID=replace-me

# Optional: primary Discord server (guild) ID for your own records.
DISCORD_GUILD_ID=optional-guild-id

# Appservice identifier registered in Synapse.
APPSERVICE_ID=discord

# Matrix bot user localpart for the bridge account.
APPSERVICE_BOT_LOCALPART=discordbot

# Sender localpart written into the appservice registration.
APPSERVICE_SENDER_LOCALPART=discordbot

# Prefix for virtual Matrix users created for Discord users.
APPSERVICE_USER_PREFIX=_discord_

# Prefix for bridged room aliases.
APPSERVICE_ALIAS_PREFIX=discord

# Secret used by the bridge when authenticating to Synapse.
APPSERVICE_AS_TOKEN=change-me-as-token

# Secret used by Synapse when sending requests to the bridge.
APPSERVICE_HS_TOKEN=change-me-hs-token

# Secret for provisioning APIs if you enable them later.
PROVISIONING_SECRET=change-me-provisioning-secret
