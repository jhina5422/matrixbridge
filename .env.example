# Public Matrix server identity
MATRIX_DOMAIN=matrix.example.com
MATRIX_HOMESERVER_URL=https://matrix.example.com

# Bridge listener
BRIDGE_PORT=9005
BRIDGE_BIND_ADDRESS=0.0.0.0

# Discord bot credentials
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_GUILD_ID=optional-guild-id

# Matrix appservice identity
APPSERVICE_ID=discord
APPSERVICE_BOT_LOCALPART=discordbot
APPSERVICE_SENDER_LOCALPART=discordbot
APPSERVICE_USER_PREFIX=_discord_
APPSERVICE_ALIAS_PREFIX=discord

# Bridge secrets - replace before production use
APPSERVICE_AS_TOKEN=change-me-as-token
APPSERVICE_HS_TOKEN=change-me-hs-token
PROVISIONING_SECRET=change-me-provisioning-secret
